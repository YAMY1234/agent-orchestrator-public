{
  "notes_url": "",
  "projects_browser_url": "http://127.0.0.1:8080/",
  "git_status_url": "http://127.0.0.1:8501/",
  "projects_root": "~/Documents/Projects",
  "remote_nodes": [
    {
      "id": "dev",
      "label": "Remote dev",
      "enabled": false,
      "url": "http://127.0.0.1:17861",
      "projects_root": "/home/example/Projects",
      "token_env": "ORCH_REMOTE_DEV_TOKEN",
      "ssh_host": "dev-server",
      "local_port": 17861,
      "remote_port": 7861,
      "auto_tunnel": false,
      "poll_interval_seconds": 3,
      "reconnect": {
        "enabled": false
      }
    }
  ],
  "sync_status": {
    "enabled": false,
    "label": "Development server",
    "local_root": "~/Documents/Projects",
    "remote_host": "dev-server",
    "remote_root": "/home/example/Projects",
    "remote_code_root": "/home/example/agent-orchestrator",
    "remote_python": "/home/example/agent-orchestrator/.venv/bin/python",
    "paths": ["my-project", "current/my-task"],
    "excludes": [".venv/", "node_modules/", "outputs/"],
    "scan_interval_seconds": 21600,
    "debounce_seconds": 30,
    "max_file_mb": 512,
    "transfer_timeout_seconds": 3600
  }
}
